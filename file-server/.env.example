# 复制为 .env 后填写：cp .env.example .env
# docker compose 和本地 uv run 都读这一份。实际 .env 已在 .gitignore 中，不要提交。

# ===== 必填，漏填时容器启动即退出 =====

# 本服务对外可访问的基址，上传接口返回的 URL 用它拼成绝对地址。
# 填调用方（浏览器、业务后端、Agent 等）实际能访问到的地址，端口与 FILE_SERVER_PORT 对应。
# 例：http://10.0.0.8:9000
PUBLIC_BASE_URL=

# ===== 以下均有默认值，需要改时才取消注释 =====

# 宿主机对外端口
#FILE_SERVER_PORT=9000
# 上传大小上限（MB），同时决定 Nginx 的 client_max_body_size
#UPLOAD_MAX_SIZE_MB=20
# 浏览器跨域直传时的允许来源，逗号分隔；只有服务端调用时留空
#CORS_ORIGINS=
# 开启后暴露 /api/docs，生产不要开
#DEBUG=false
